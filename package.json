{
  "name": "model-y-field-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Independent German and English Model Y learning guide with optional local 3D assets.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "prestart": "node scripts/assets.mjs",
    "assets": "node scripts/assets.mjs",
    "build": "node scripts/build.mjs && node scripts/release-check.mjs --dist",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "check:release": "node scripts/release-check.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:charge-film": "node tests/charge-film-browser.mjs",
    "pretest:public": "npm run build",
    "test:public": "node tests/public-browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/app.js && node --check public/model.js && node --check public/locales.js && npm run check:release && npm run vendor:check && npm test"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
